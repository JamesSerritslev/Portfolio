# Server-only. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=

# Upstash Redis REST credentials for chat rate limits. Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site-wide chat messages per UTC day. Defaults to 500.
CHAT_DAILY_CAP=500

# Cloudflare Turnstile. The secret stays on the server.
# The site key is public by design (the widget runs in the browser). It is not the Groq key.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local dummy keys that always pass, from Cloudflare's Turnstile testing docs:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
